# Copy this file to .env for local testing. Never commit .env.

# Groq - primary AI provider
GROQ_API_KEY=your-groq-api-key

# Google Gemini - last AI fallback
GEMINI_API_KEY=your-gemini-api-key

TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Comma-separated list of Telegram chat IDs. Example: 123456789
# Note: a phone number is NOT a valid chat_id. Message the bot first, then
# use the numeric chat ID from Telegram.
TELEGRAM_CHAT_IDS=123456789

# Secret used by the manual test endpoint: /test?secret=...
TEST_SECRET=replace-with-a-long-random-secret
